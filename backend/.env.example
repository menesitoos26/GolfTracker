# Copia este fichero a backend/.env y ajusta los valores.

# Base de datos. En local, SQLite basta y no hace falta instalar nada.
# En Docker se usa MySQL: mysql+pymysql://golf_user:golf_pass@db:3306/golf_db
DATABASE_URL=sqlite:///./golf_tracker.db

# Clave de firma de los tokens JWT (mínimo 32 caracteres).
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria-de-verdad

# development | production
ENVIRONMENT=development

# Orígenes permitidos por CORS, separados por comas.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Opcional: clave de la API externa de campos de golf.
# Si la dejas vacía, el buscador sólo sugiere campos donde ya has jugado.
GOLF_COURSE_API_KEY=
